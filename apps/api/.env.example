NODE_ENV=development
PORT=5000
# The web app origin(s), comma-separated. The widget is NOT listed: intake CORS is per form (Phase 13).
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000
# "false" in production, where `pnpm start:worker` runs src/worker.ts as its own process.
RUN_WORKERS_IN_API=true
DATABASE_URL=postgresql://enquiry:enquiry@localhost:5432/enquiry
LOG_LEVEL=debug
SERVICE_NAME=api
# openssl rand -hex 16
CONTACT_HASH_SALT=

# Two DIFFERENT random secrets of at least 32 characters; the server refuses to start otherwise.
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth Web Client ID for sign-in (Google Cloud Console -> APIs & Services -> Credentials ->
# Create OAuth client ID -> Web; authorised JavaScript origin http://localhost:3000).
GOOGLE_CLIENT_ID=

# Proxies in front of this app whose client-IP headers (X-Forwarded-For, cf-connecting-ip)
# may be believed, as comma-separated IPv4/IPv6 CIDRs. Express and the rate limiter both use this
# list. It must name the machine that opens the TCP connection to this app, and nothing else.
#   - Behind a load balancer or reverse proxy (nginx, Render, Railway, an ALB...), list ITS address
#     range here. Otherwise every request appears to come from the proxy, and all users share a
#     single rate-limit bucket: a handful of bad logins would block login for everyone.
#   - On Render: requests go Cloudflare -> Render load balancer (10.x) -> a proxy inside the
#     instance, and that proxy is what connects to this app, over loopback. Use 127.0.0.1/32.
#     Render doesn't document this; it was confirmed by logging req.socket.remoteAddress, so
#     re-check that way if the rate limiter starts treating all users as one. Do NOT add
#     Cloudflare's, Render's 10.x or Vercel's ranges: none of them connects to this app directly.
#   - Cloudflare in front of your OWN server (it connects to you directly): list
#     https://www.cloudflare.com/ips-v4 and ips-v6.
#   - Exposed directly to the internet, leave it EMPTY: a trusted header lets any client choose
#     its own rate-limit bucket.
TRUSTED_PROXY_CIDRS=

# Queue / rate-limit Redis (docker-compose `redis`, noeviction). The cache instance (Phase 07) defaults
# to the same host on port 6380.
REDIS_HOST=localhost
REDIS_PORT=6379
# Empty for the local docker Redis; set for a hosted one. A hosted database must use `noeviction`.
REDIS_USERNAME=
REDIS_PASSWORD=
# Response cache Redis (Phase 07): a SEPARATE instance that is allowed to evict (volatile-lru).
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6380
CACHE_REDIS_USERNAME=
CACHE_REDIS_PASSWORD=

# Accepted form/email messages per business per 24 h before new ones are held, not rejected (Phase 13).
INTAKE_DAILY_CAP=300
# Shows how the rate limiter identifies callers at /debug-ip. Keep false except while setting TRUSTED_PROXY_CIDRS.
DEBUG_IP_ENDPOINT=false
# Set to false to bypass the cache entirely (every read goes to PostgreSQL).
CACHE_ENABLED=true

# BullMQ dashboard at /admin/queues. Its job payloads contain password-reset and verification
# tokens, so it stays off unless switched on here, and needs credentials when on.
ENABLE_QUEUE_DASHBOARD=false
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=
# Port of the standalone worker's health server (defaults to PORT, then 8080).
WORKER_PORT=8080

# Gmail API sender for SYSTEM mail (verification, reset; a separate OAuth client from each business's
# own Gmail, Phase 25). One-time setup: start the server, open http://localhost:5000/api/auth/gmail,
# consent, and paste the refresh token printed in the server console into GMAIL_REFRESH_TOKEN. Details:
# ~/Code/e-commerce/docs/gmail-api-email-sender.md. Without a token, dev mode logs mail to a dev mailbox.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_NAME="Enquiry Copilot"
# Exposes the authorization routes in production while you re-authorize; switch off again after.
GMAIL_OAUTH_SETUP=false
